{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Routina chat response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": { "enum": ["routine", "message"] },
    "message": { "type": "string", "minLength": 1 },
    "routine": { "$ref": "#/$defs/routine" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "routine" } },
        "required": ["type"]
      },
      "then": { "required": ["routine"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "message" } },
        "required": ["type"]
      },
      "then": { "required": ["message"] }
    }
  ],
  "$defs": {
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "days_per_week",
        "session_duration",
        "format",
        "exercises",
        "general_notes",
        "warning"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "days_per_week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "session_duration": {
          "type": "integer",
          "minimum": 1,
          "description": "Session duration in minutes"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sets", "reps", "rest_sec", "notes"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "sets": { "type": "integer", "minimum": 1 },
              "reps": { "type": "string", "minLength": 1 },
              "rest_sec": { "type": "integer", "minimum": 0 },
              "notes": { "type": "string" }
            }
          }
        },
        "general_notes": { "type": "string" },
        "warning": { "type": "string" }
      }
    }
  }
}
