{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Respuesta de agente de Routina v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tipo"
  ],
  "properties": {
    "tipo": {
      "enum": [
        "rutina",
        "mensaje",
        "preguntas"
      ]
    },
    "mensaje": {
      "type": "string",
      "minLength": 1
    },
    "rutina": {
      "$ref": "#/$defs/rutina"
    },
    "preguntas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pregunta",
          "opciones"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pregunta": {
            "type": "string",
            "minLength": 1
          },
          "opciones": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "multiple": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "rutina"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "then": {
        "required": [
          "rutina"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "mensaje"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "then": {
        "required": [
          "mensaje"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "preguntas"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "then": {
        "required": [
          "preguntas"
        ]
      }
    }
  ],
  "$defs": {
    "rutina": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objetivo",
        "dias_por_semana",
        "duracion_sesion",
        "formato",
        "ejercicios",
        "notas_generales",
        "advertencia"
      ],
      "properties": {
        "objetivo": {
          "type": "string",
          "minLength": 1
        },
        "dias_por_semana": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "duracion_sesion": {
          "type": "integer",
          "minimum": 1,
          "description": "Duración por sesión en minutos"
        },
        "formato": {
          "type": "string",
          "minLength": 1
        },
        "ejercicios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nombre",
              "series",
              "repeticiones",
              "descanso_seg",
              "notas"
            ],
            "properties": {
              "nombre": {
                "type": "string",
                "minLength": 1
              },
              "series": {
                "type": "integer",
                "minimum": 1
              },
              "repeticiones": {
                "type": "string",
                "minLength": 1
              },
              "descanso_seg": {
                "type": "integer",
                "minimum": 0
              },
              "notas": {
                "type": "string"
              }
            }
          }
        },
        "notas_generales": {
          "type": "string"
        },
        "advertencia": {
          "type": "string"
        }
      }
    }
  }
}
